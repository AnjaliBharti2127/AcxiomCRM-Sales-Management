@model List<Activity>
@{ViewData["Title"]="Activities";}
<div class="heading"><div><small>CRM / RECORDS</small><h1>Activities</h1></div><a class="btn btn-primary" asp-action="Create">+ New Activity</a></div>
<form method="get" class="panel filters"><input class="form-control" name="q" value="@ViewBag.Q" placeholder="Search records"><input class="form-control" name="status" value="@ViewBag.Status" placeholder="Status / stage"><select class="form-select" name="owner" asp-items="ViewBag.Owners"><option value="">All owners</option></select><button class="btn btn-dark">Filter</button></form>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>ActivityType</th><th>Subject</th><th>Description</th><th>ActivityDate</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.ActivityType</td><td>@e.Subject</td><td>@e.Description</td><td>@e.ActivityDate</td><td>@e.Status</td><td><div class="d-flex gap-2 flex-wrap"><a asp-action="Details" asp-route-id="@e.Id">View</a><a asp-action="Edit" asp-route-id="@e.Id">Edit</a><form asp-action="Delete" asp-route-id="@e.Id" method="post" onsubmit="return confirm('Deactivate this record?')"><button class="btn btn-link text-danger p-0">Delete</button></form></div></td></tr>}</tbody></table>@if(Model.Count==0){<p class="text-muted">No matching records.</p>}</div><div class="d-flex gap-3 align-items-center">@if(ViewBag.Page>1){<a asp-route-page="@(ViewBag.Page-1)" asp-route-q="@ViewBag.Q" asp-route-status="@ViewBag.Status" asp-route-owner="@ViewBag.Owner">Previous</a>}<span>Page @ViewBag.Page · @ViewBag.Total records</span>@if(ViewBag.Page*15<ViewBag.Total){<a asp-route-page="@(ViewBag.Page+1)" asp-route-q="@ViewBag.Q" asp-route-status="@ViewBag.Status" asp-route-owner="@ViewBag.Owner">Next</a>}</div>
