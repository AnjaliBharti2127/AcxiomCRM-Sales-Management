@model Activity
<h1>Record details</h1><div class="panel"><dl class="row"><dt class="col-sm-4">ActivityType</dt><dd class="col-sm-8">@Model.ActivityType</dd><dt class="col-sm-4">Subject</dt><dd class="col-sm-8">@Model.Subject</dd><dt class="col-sm-4">Description</dt><dd class="col-sm-8">@Model.Description</dd><dt class="col-sm-4">ActivityDate</dt><dd class="col-sm-8">@Model.ActivityDate</dd><dt class="col-sm-4">CustomerId</dt><dd class="col-sm-8">@Model.CustomerId</dd><dt class="col-sm-4">LeadId</dt><dd class="col-sm-8">@Model.LeadId</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd></dl><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a> <a asp-action="Index">Back</a></div>
