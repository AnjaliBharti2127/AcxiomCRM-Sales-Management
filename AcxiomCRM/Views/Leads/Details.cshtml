@model Lead
<h1>Record details</h1><div class="panel"><dl class="row"><dt class="col-sm-4">LeadName</dt><dd class="col-sm-8">@Model.LeadName</dd><dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd><dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@Model.Phone</dd><dt class="col-sm-4">CompanyName</dt><dd class="col-sm-8">@Model.CompanyName</dd><dt class="col-sm-4">Source</dt><dd class="col-sm-8">@Model.Source</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">@Model.Status</dd><dt class="col-sm-4">ExpectedValue</dt><dd class="col-sm-8">@Model.ExpectedValue</dd><dt class="col-sm-4">Priority</dt><dd class="col-sm-8">@Model.Priority</dd><dt class="col-sm-4">Notes</dt><dd class="col-sm-8">@Model.Notes</dd></dl><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a> <a asp-action="Index">Back</a></div>
