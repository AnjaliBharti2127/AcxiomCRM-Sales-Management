on value="Medium">Medium</option><option value="High">High</option></select><span asp-validation-for="Priority" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Notes" class="form-label"></label><input asp-for="Notes" class="form-control"/><span asp-validation-for="Notes" class="text-danger"></span></div><div class="col-md-6"><label asp-for="AssignedTo">Owner</label><select asp-for="AssignedTo" asp-items="ViewBag.Owners" class="form-select"></select></div></div><button class="btn btn-primary mt-4">Save record</button></form>
