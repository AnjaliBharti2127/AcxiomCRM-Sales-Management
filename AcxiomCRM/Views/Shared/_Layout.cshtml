<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>@ViewData["Title"] | AcxiomCRM</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/site.css"></head><body><div class="shell">@if(User.Identity?.IsAuthenticated==true){<aside><a class="brand" asp-controller="Dashboard" asp-action="Index">Acxiom<span>CRM</span></a><small>WORKSPACE</small><nav>@foreach(var item in new[]{"Dashboard","Customers","Leads","Opportunities","FollowUps","Activities","Reports"}){<a asp-controller="@item" asp-action="Index">@item</a>}@if(User.IsInRole("Admin")){<small>ADMINISTRATION</small><a asp-controller="Users" asp-action="Index">Users & roles</a><a asp-controller="AuditLogs" asp-action="Index">Audit log</a>}</nav></aside>}<main><header><span>Sales workspace</span>@if(User.Identity?.IsAuthenticated==true){<div class="d-flex gap-3 align-items-center"><small>@User.Identity.Name</small><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-secondary btn-sm">Sign out</button></form></div>}</header><section class="content">@if(TempData["Message"]!=null){<div class="alert alert-info">@TempData["Message"]</div>}@RenderBody()</section><footer>AcxiomCRM · Customer relationship management</footer></main></div><script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script><script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script><script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script><script src="~/js/validation.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
