@model UserEdit
<h1>User editor</h1><form class="panel" asp-action="Edit" asp-route-id="@ViewBag.Id" method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="FullName"></label><input asp-for="FullName" class="form-control mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control mb-3"><label asp-for="Role"></label><select asp-for="Role" class="form-select mb-3"><option>Admin</option><option>Manager</option><option>SalesExecutive</option></select><label asp-for="ManagerId">Manager</label><select asp-for="ManagerId" class="form-select mb-3"><option value="">None</option>@foreach(ApplicationUser u in ViewBag.Managers){<option value="@u.Id">@u.FullName</option>}</select><label asp-for="Password">Initial or replacement password (optional when editing)</label><input asp-for="Password" class="form-control mb-3" autocomplete="new-password"><label><input asp-for="IsActive"> Active account</label><br><button class="btn btn-primary mt-3">Save</button></form>
