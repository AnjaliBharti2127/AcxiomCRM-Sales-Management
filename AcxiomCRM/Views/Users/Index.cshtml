@model List<(ApplicationUser,string)>
<div class="heading"><h1>Users & roles</h1><a class="btn btn-primary" asp-action="Edit">+ New user</a></div><form class="panel filters" method="get"><input name="q" class="form-control" placeholder="Search users"><button class="btn btn-dark">Search</button></form><div class="panel table-responsive"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Active</th><th>Lockout end</th><th>Actions</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Item1.FullName</td><td>@r.Item1.Email</td><td>@r.Item2</td><td>@r.Item1.IsActive</td><td>@r.Item1.LockoutEnd</td><td><a asp-action="Edit" asp-route-id="@r.Item1.Id">Edit</a><form asp-action="Unlock" asp-route-id="@r.Item1.Id" method="post"><button class="btn btn-link p-0">Unlock</button></form></td></tr>}</tbody></table></div>
