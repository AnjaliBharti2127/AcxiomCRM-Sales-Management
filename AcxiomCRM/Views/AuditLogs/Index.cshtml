@model List<AuditLog>
<h1>Audit log</h1><form method="get" class="panel filters"><input name="actionName" class="form-control" placeholder="Action"><input name="entity" class="form-control" placeholder="Entity"><input name="user" class="form-control" placeholder="User ID"><input name="from" type="date" class="form-control"><input name="to" type="date" class="form-control"><button class="btn btn-dark">Filter</button></form><div class="panel table-responsive"><table class="table"><thead><tr><th>Date (UTC)</th><th>Action</th><th>Entity</th><th>User</th><th>Result</th><th>Changes</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.CreatedDate</td><td>@a.Action</td><td>@a.EntityName / @a.RecordId</td><td>@a.UserId</td><td>@a.Result</td><td><details><summary>View</summary><pre>@a.OldValue</pre><pre>@a.NewValue</pre><small>@a.IpAddress</small></details></td></tr>}</tbody></table></div>
