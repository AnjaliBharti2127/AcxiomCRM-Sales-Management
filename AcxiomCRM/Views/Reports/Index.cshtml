@model List<ReportRow>
<h1>Reports</h1><form method="get" class="panel"><div class="row g-2"><div class="col-md-3"><select class="form-select" name="type">@foreach(var t in new[]{"customers","leads","followups","opportunities","pipeline","conversion","activities","audit"}){if((t=="audit"&&!User.IsInRole("Admin"))||(t=="activities"&&User.IsInRole("SalesExecutive")))continue;<option value="@t" selected="@(t==(string)ViewBag.Type)">@t</option>}</select></div><div class="col-md-3"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search"></div><div class="col-md-2"><input name="status" value="@ViewBag.Status" class="form-control" placeholder="Status"></div><div class="col-md-2"><input name="from" type="date" value="@ViewBag.From" class="form-control"></div><div class="col-md-2"><input name="to" type="date" value="@ViewBag.To" class="form-control"></div></div><button class="btn btn-primary mt-3">Run report</button> <button class="btn btn-outline-primary mt-3" name="export" value="true">Export CSV</button></form><div class="panel"><h5>@Model.Count records · Total value @Model.Sum(x=>x.Value).ToString("N2")</h5><table class="table"><thead><tr><th>Name</th><th>Status</th><th>Owner ID</th><th>Date</th><th>Value</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Name</td><td>@r.Status</td><td>@r.Owner</td><td>@r.Date.ToShortDateString()</td><td>@r.Value.ToString("N2")</td></tr>}</tbody></table></div>
