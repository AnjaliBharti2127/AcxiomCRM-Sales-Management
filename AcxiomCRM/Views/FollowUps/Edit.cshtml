@model FollowUpInput
@{ViewData["Title"]="FollowUp editor";string action=ViewBag.Editing==true?"Edit":"Create";}
<div class="heading"><h1>@action FollowUp</h1><a asp-action="Index">Back to list</a></div><form class="panel" asp-action="@action" asp-route-id="@ViewBag.Id" method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control"/><span asp-validation-for="Subject" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CustomerId" class="form-label"></label><select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select"><option value="">Select record</option></select><span asp-validation-for="CustomerId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="LeadId" class="form-label"></label><select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select"><option value="">Select record</option></select><span asp-validation-for="LeadId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="OpportunityId" class="form-label"></label><select asp-for="OpportunityId" asp-items="ViewBag.Opportunitys" class="form-select"><option value="">Select record</option></select><span asp-validation-for="OpportunityId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="FollowUpDate" class="form-label"></label><input asp-for="FollowUpDate" class="form-control" type="date"/><span asp-validation-for="FollowUpDate" class="text-danger"></span></div><div class="col-md-6"><label asp-for="FollowUpType" class="form-label"></label><select asp-for="FollowUpType" class="form-select"><option value="Call">Call</option><option value="Meeting">Meeting</option><option value="Email">Email</option><option value="Task">Task</option></select><span asp-validation-for="FollowUpType" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Remarks" class="form-label"></label><input asp-for="Remarks" class="form-control"/><span asp-validation-for="Remarks" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option value="Planned">Planned</option><option value="Completed">Completed</option><option value="Missed">Missed</option><option value="Cancelled">Cancelled</option></select><span asp-validation-for="Status" class="text-danger"></span></div><div class="col-md-6"><label asp-for="AssignedTo">Owner</label><select asp-for="AssignedTo" asp-items="ViewBag.Owners" class="form-select"></select></div></div><button class="btn btn-primary mt-4">Save record</button></form>
