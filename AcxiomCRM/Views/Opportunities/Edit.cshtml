@model OpportunityInput
@{ViewData["Title"]="Opportunity editor";string action=ViewBag.Editing==true?"Edit":"Create";}
<div class="heading"><h1>@action Opportunity</h1><a asp-action="Index">Back to list</a></div><form class="panel" asp-action="@action" asp-route-id="@ViewBag.Id" method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="OpportunityName" class="form-label"></label><input asp-for="OpportunityName" class="form-control"/><span asp-validation-for="OpportunityName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CustomerId" class="form-label"></label><select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select"><option value="">Select record</option></select><span asp-validation-for="CustomerId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="LeadId" class="form-label"></label><select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select"><option value="">Select record</option></select><span asp-validation-for="LeadId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control"/><span asp-validation-for="Amount" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" class="form-select"><option value="Qualification">Qualification</option><option value="Proposal">Proposal</option><option value="Negotiation">Negotiation</option><option value="Won">Won</option><option value="Lost">Lost</option></select><span asp-validation-for="Stage" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" class="form-control"/><span asp-validation-for="Probability" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" class="form-control" type="date"/><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Source" class="form-label"></label><input asp-for="Source" class="form-control"/><span asp-validation-for="Source" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Notes" class="form-label"></label><input asp-for="Notes" class="form-control"/><span asp-validation-for="Notes" class="text-danger"></span></div><div class="col-md-6"><label asp-for="AssignedTo">Owner</label><select asp-for="AssignedTo" asp-items="ViewBag.Owners" class="form-select"></select></div></div><button class="btn btn-primary mt-4">Save record</button></form>
