@model Opportunity
<h1>Record details</h1><div class="panel"><dl class="row"><dt class="col-sm-4">OpportunityName</dt><dd class="col-sm-8">@Model.OpportunityName</dd><dt class="col-sm-4">CustomerId</dt><dd class="col-sm-8">@Model.CustomerId</dd><dt class="col-sm-4">LeadId</dt><dd class="col-sm-8">@Model.LeadId</dd><dt class="col-sm-4">Amount</dt><dd class="col-sm-8">@Model.Amount</dd><dt class="col-sm-4">Stage</dt><dd class="col-sm-8">@Model.Stage</dd><dt class="col-sm-4">Probability</dt><dd class="col-sm-8">@Model.Probability</dd><dt class="col-sm-4">ExpectedCloseDate</dt><dd class="col-sm-8">@Model.ExpectedCloseDate</dd><dt class="col-sm-4">Source</dt><dd class="col-sm-8">@Model.Source</dd><dt class="col-sm-4">Notes</dt><dd class="col-sm-8">@Model.Notes</dd></dl><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a> <a asp-action="Index">Back</a></div>
