@model List<FollowUp>
@using System.Text.Json
<div class="heading"><div><small>OVERVIEW / SALES</small><h1>Dashboard</h1><p class="text-muted mb-0">Monitor your customer relationships and sales performance.</p></div></div><form class="panel filters" method="get"><input type="date" name="from" value="@ViewBag.From" class="form-control" aria-label="Start date"><input type="date" name="to" value="@ViewBag.To" class="form-control" aria-label="End date"><button class="btn btn-dark">Apply dates</button><a asp-action="Index" class="btn btn-light">Clear</a></form><div class="row g-3">@foreach(var card in (Dictionary<string,string>)ViewBag.Cards){<div class="col-6 col-xl-3"><div class="metric"><small>@card.Key</small><strong>@card.Value</strong></div></div>}</div><div class="row"><div class="col-lg-6"><div class="panel"><h5>Lead status</h5><div class="chartbox"><canvas id="leads"></canvas></div></div></div><div class="col-lg-6"><div class="panel"><h5>Opportunity pipeline</h5><div class="chartbox"><canvas id="pipeline"></canvas></div></div></div><div class="col-12"><div class="panel"><h5>Monthly sales</h5><div class="chartbox"><canvas id="sales"></canvas></div></div></div></div><div class="panel"><h5>Pending follow-ups</h5><table class="table"><thead><tr><th>Subject</th><th>Date</th><th>State</th></tr></thead><tbody>@foreach(var f in Model){<tr><td><a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.Id">@f.Subject</a></td><td>@f.FollowUpDate.ToShortDateString()</td><td>@(f.FollowUpDate.Date<DateTime.Today?"Overdue":"Upcoming")</td></tr>}</tbody></table></div>
@section Scripts{<script>function chart(id,type,data){new Chart(document.getElementById(id),{type,data:{labels:Object.keys(data),datasets:[{label:id,data:Object.values(data),backgroundColor:['#2463ba','#53a6c8','#35a28d','#e6ac4a','#8b7cbd','#d66f76'],borderColor:'#2463ba',tension:.3}]},options:{responsive:true,maintainAspectRatio:false}})}chart('leads','doughnut',@Html.Raw(JsonSerializer.Serialize((object)ViewBag.Leads)));chart('pipeline','bar',@Html.Raw(JsonSerializer.Serialize((object)ViewBag.Pipeline)));chart('sales','line',@Html.Raw(JsonSerializer.Serialize((object)ViewBag.Sales)));</script>}
